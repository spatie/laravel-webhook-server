{
    "name": "spatie/laravel-webhook-server",
    "description": "Send webhooks in Laravel apps",
    "keywords": [
        "spatie",
        "laravel-webhook-server",
        "webhook",
        "server"
    ],
    "homepage": "https://github.com/spatie/laravel-webhook-server",
    "license": "MIT",
    "authors": [
        {
            "name": "Freek Van der Herten",
            "email": "freek@spatie.be",
            "homepage": "https://spatie.be",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8.2|^8.0",
        "illuminate/bus": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-package-tools": "^1.11"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "larastan/larastan": "^3.13",
        "mockery/mockery": "^1.6.10",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.3",
        "spatie/test-time": "^1.2.2"
    },
    "autoload": {
        "psr-4": {
            "Spatie\\WebhookServer\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spatie\\WebhookServer\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=512M",
        "format": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes",
        "format-test": "@format --dry-run --diff",
        "test": "@php vendor/bin/pest",
        "test-coverage": "@php vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spatie\\WebhookServer\\WebhookServerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
